# Claude API
CLAUDE_API_KEY=sk-ant-api03-your-api-key-here

# Email konfigurace
EMAIL_TO=tvuj-email@example.com
EMAIL_FROM=content-agent@tvujweb.cz

# SMTP nastavení (pro Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tvuj-email@gmail.com
SMTP_PASSWORD=tvoje-app-password

# Nastavení agenta
MAX_ARTICLES_PER_SOURCE=10
MIN_VIRALITY_SCORE=50

# WordPress publishing (volitelné)
WP_URL=https://tvuj-wordpress.cz
WP_USER=api-username
WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# RAWG.io API (volitelné - herní obrázky v publish panelu, zdarma na rawg.io/apidocs)
RAWG_API_KEY=your-rawg-api-key

# Dashboard autentizace (volitelné - pokud prázdné, auth je vypnuta)
DASHBOARD_TOKEN=

# Modely (volitelné — bez nich platí defaulty z config.py)
# POZOR: claude-sonnet-4-20250514 už API nezná (404), nepoužívat.
# ARTICLE_MODEL     — psaní českého článku (default claude-opus-5)
# TRANSLATION_MODEL — anglická lokalizace (default claude-sonnet-4-6)
# ANALYSIS_MODEL    — výběr témat z RSS (default claude-haiku-4-5-20251001)
#ARTICLE_MODEL=claude-opus-5
#TRANSLATION_MODEL=claude-sonnet-4-6
#ANALYSIS_MODEL=claude-haiku-4-5-20251001

# Maximální délka summary při scrapování RSS (znaky, default 500)
SUMMARY_MAX_LENGTH=500
